{
    "name": "di-conservas/mvc-app",
    "description": "Sistema MVC para Di Conservas - Catálogo de Produtos",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Di Conservas Team"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Autoloader.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "post-install-cmd": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    }
}