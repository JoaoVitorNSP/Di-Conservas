# Di Conservas

Options -Indexes
DirectoryIndex index.html index.php

# O painel precisa de limites um pouco maiores para receber fotos
<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
</IfModule>

# Arquivos internos do projeto não ficam acessíveis pelo navegador.
# O site lê o catálogo por products-api.php.
<FilesMatch "^(products\.json|README.*|Dockerfile|docker-compose\.yml|apache-config\.conf)$">
    Require all denied
</FilesMatch>
RedirectMatch 404 /\.(?!well-known)

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header setifempty Referrer-Policy "strict-origin-when-cross-origin"
    Header set X-Frame-Options "DENY"
</IfModule>

# Guarda imagens, CSS e JS no navegador.
# Ao alterar site.css ou site.js, aumente o ?v= no index.html.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/css text/javascript application/javascript application/json
</IfModule>
