# Copie para .env e preencha. O .env nunca vai para o Git.

# Mostra detalhes de erro na tela. Mantenha false no site publicado.
APP_DEBUG=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=di_conservas
DB_USER=root
DB_PASS=

# Código usado só para criar o primeiro acesso em /admin (mínimo de 16 caracteres).
# Pode apagar depois de criar o administrador.
SETUP_TOKEN=
