Options -Indexes
DirectoryIndex index.php

# Arquivos ocultos (.htaccess e afins) não abrem pelo navegador
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# O que não for arquivo real vai para o front controller
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L,QSA]

<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header setifempty Referrer-Policy "strict-origin-when-cross-origin"
    Header set X-Frame-Options "DENY"
</IfModule>

# Guarda imagens, CSS e JS no navegador.
# Ao alterar CSS ou JS, aumente o ?v= onde o arquivo é carregado.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/css text/javascript application/javascript application/json
</IfModule>
