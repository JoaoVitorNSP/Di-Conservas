# Pasta de arquivos públicos: nada aqui pode ser executado como código no servidor.
<FilesMatch "\.(php[0-9]?|phtml|phps|phar|pl|py|cgi|sh|htaccess)$">
    Require all denied
</FilesMatch>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
RemoveHandler .php .phtml .phar
RemoveType .php .phtml .phar
